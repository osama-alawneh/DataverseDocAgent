{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Codex": {
    "Executable": "codex",
    "TimeoutSeconds": 180
  },
  "Dataverse": {
    "TestCredentials": {
      "Url": "",
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "RateLimiting": {
    "CredentialEndpoints": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Generation": {
    "PerTaskTimeoutMinutes": 30
  }
}
