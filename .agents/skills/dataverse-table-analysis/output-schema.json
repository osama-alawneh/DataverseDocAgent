{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dataverse stage analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stageId",
    "skillVersion",
    "inputHash",
    "coveredComponentIds",
    "findings",
    "limitations"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "stageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "skillVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "inputHash": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "coveredComponentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 200
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "componentId",
          "evidenceId",
          "basis",
          "text"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "enum": [
              "fact",
              "inference"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
